
# ==============================================================================
# BOR AWS Bedrock Configuration
# ==============================================================================
# This file contains all the configuration options for BOR's AWS Bedrock integration.
# Choose ONE authentication method below based on your deployment scenario.

# ==============================================================================
# AWS AUTHENTICATION METHODS (Priority Order: 1 → 2 → 3 → 4)
# ==============================================================================

# Method 1: Bedrock API Key (HIGHEST PRIORITY - Simplest for getting started)
# Generate in AWS Console: Bedrock > API keys
# Uncomment the line below and replace with your actual API key:
# AWS_BEARER_TOKEN_BEDROCK="bedrock-api-key-here"

# Method 2: AWS Named Profile (Recommended for local development)
# Use AWS CLI configured profiles: `aws configure --profile your-profile-name`
# Uncomment the line below and replace with your profile name:
# AWS_PROFILE="default"

# Method 3: Explicit AWS Credentials (Good for Docker/CI/CD)
# Get these from AWS Console > IAM > Users > Security Credentials
# Uncomment the lines below and replace with your actual credentials:
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"

# Method 4: Temporary Session Credentials (For STS/assume role scenarios)
# Include session token when using temporary credentials:
# AWS_SESSION_TOKEN="your-session-token"

# ==============================================================================
# AWS BEDROCK CONFIGURATION
# ==============================================================================

# AWS Region where your Bedrock models are available
# Common regions: us-east-1, us-west-2, eu-west-1
BEDROCK_REGION="us-east-1"

# Bedrock Chat Model ID for text generation
# Available models:
# - us.anthropic.claude-sonnet-4-5-20250929-v1:0 (Claude 3.5 Sonnet)
# - us.anthropic.claude-haiku-4-5-20251017-v1:0 (Claude 3.5 Haiku - faster/cheaper)
# - amazon.titan-text-premier-v1:0 (Amazon Titan)
BEDROCK_MODEL_ID="us.anthropic.claude-sonnet-4-5-20250929-v1:0"

# Bedrock Embedding Model ID for vector embeddings
# Available models:
# - amazon.titan-embed-text-v2:0 (Amazon Titan Embeddings v2)
# - amazon.titan-embed-text-v1 (Amazon Titan Embeddings v1)
BEDROCK_EMBEDDING_MODEL="amazon.titan-embed-text-v2:0"

# ==============================================================================
# MODEL PARAMETERS
# ==============================================================================

# Temperature for text generation (0.0 = deterministic, 1.0 = creative)
LLM_MODEL_TEMPERATURE=0.2

# ==============================================================================
# INFRASTRUCTURE CONFIGURATION
# ==============================================================================

# Memgraph Configuration (Knowledge Graph Database)
MEMGRAPH_HOST="memgraph"
MEMGRAPH_PORT=7687

# Chroma Configuration (Vector Database for Embeddings)
CHROMA_DATA_DIR="/etc/chroma"
CHROMA_VECTOR_SPACE="cosine"

# ==============================================================================
# DEVELOPMENT/TESTING OPTIONS
# ==============================================================================

# Enable mock data for testing (set to True for development)
# MOCK="False"

# ==============================================================================
# DOCKER-SPECIFIC OVERRIDES
# ==============================================================================
# When running in Docker, you might want to override some settings:
# MEMGRAPH_HOST="127.0.0.1"  # For local Memgraph
# CHROMA_DATA_DIR="./data/chroma"  # For local development